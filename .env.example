XINCHAO_BRIDGE_BASE_URL=https://example.com
XINCHAO_BRIDGE_MACHINE_TOKEN=replace-with-machine-token
# process: 本地 Agent / Runtime Adapter
XINCHAO_BRIDGE_INJECTOR_MODE=process
XINCHAO_BRIDGE_INJECTOR_EXECUTABLE=node
XINCHAO_BRIDGE_INJECTOR_ARGS_JSON=["/absolute/path/to/your-runtime-adapter.mjs"]
# XINCHAO_BRIDGE_INJECTOR_WORKING_DIRECTORY=/absolute/path/to/runtime

# webhook: 自建前端后端、手机服务或远端 Agent（与 process 二选一）
# XINCHAO_BRIDGE_INJECTOR_MODE=webhook
# XINCHAO_BRIDGE_WEBHOOK_URL=https://your-runtime.example.com/xinchao/wake
# XINCHAO_BRIDGE_WEBHOOK_TOKEN=replace-with-a-different-long-token

# XINCHAO_BRIDGE_LOG_LEVEL=info
# XINCHAO_BRIDGE_CONNECT_TIMEOUT_MS=15000
# XINCHAO_BRIDGE_INJECT_TIMEOUT_MS=30000
